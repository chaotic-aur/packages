_bump() {
  local _new_ver="${1%%-*}"
  local _new_rel="${1##*-}"
  local _new_hash="${2:?}"

  local _sumtype=$(grep -Pom1 '\S+sums' PKGBUILD)
  local _old_source=$(grep -Pom1 'source = \K\S+$' .SRCINFO)

  if [ "$(vercmp "${_new_ver:?}-${_new_rel:-1}" "$pkgver-$pkgrel")" -gt 0 ]; then
    source[0]="${_old_source//$pkgver/$_new_ver}"
    eval "${_sumtype}[0]='${_new_hash}'"

    pkgver="$_new_ver"
    pkgrel="${_new_rel:-1}"
  fi
}
_bump 151.0.4129.78-1 38161c8c49dc88f1dc1c9797d78a63064611e1490b8c2ca290afa0677027ef8b
