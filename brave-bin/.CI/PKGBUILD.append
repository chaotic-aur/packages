_bump() {
  local _new_ver="${1%%-*}"
  local _new_rel="${1##*-}"
  local _new_hash="${2:?}"
  local _type="${3:-}"

  local _sumtype=$(grep -Pom1 "\\S+sums${_type:+_$_type}" PKGBUILD)
  local _old_source=$(grep -Pom1 "source${_type:+_$_type} = \\K\\S+\$" .SRCINFO)

  if [ "$(vercmp "${_new_ver:?}-${_new_rel:-1}" "$pkgver-$pkgrel")" -gt 0 ]; then
    eval "source${_type:+_$_type}[0]='${_old_source//$pkgver/$_new_ver}'"
    eval "${_sumtype}[0]='${_new_hash}'"

    noextract=(${noextract[@]//$pkgver/$_new_ver})

    pkgver="$_new_ver"
    pkgrel="${_new_rel:-1}"
  fi
}
_bump 1.93.135-1 2563bd8760b7fe87df86d7f8df128d8b585f96b9a4f110f13ee988ebf3d6fb68 x86_64
