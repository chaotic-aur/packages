url="https://github.com/awesomeWM/awesome"
license=('GPL-2.0-or-later')

# keep using lua 5.4 for now
_LUA_VER=5.4
depends=(${depends[@]//lua*} lua54 lua54-lgi)

_pkgsrc="$pkgname"
pkgver() {
  cd "$_pkgsrc"

  git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
}
