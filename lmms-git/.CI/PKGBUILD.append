url="https://github.com/LMMS/lmms"
license=('GPL-2.0-or-later')

makedepends+=('cairo')
export CXXFLAGS="${CXXFLAGS} -I/usr/include/cairo"

_pkgsrc="lmms"
pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
}
