pkgname=(processing)
url="https://github.com/processing/processing4"

license=(
  'GPL-2.0-only'
  'LGPL-2.1-only' # core library
)

makedepends+=('xdg-utils')

# jdk17-temurin is AUR-only
depends=("${depends[@]/#jdk17-temurin/jdk17-openjdk}")
eval "$(declare -f build | sed -E -e 's&java-17-temurin&java-17-openjdk&g')"
eval "$(declare -f package_processing | sed -E -e 's&java-17-temurin&java-17-openjdk&g')"

eval _orig_"$(declare -f package_processing)"

package_processing() {
  # needs to be present to be removed later
  install -Dm644 /dev/null "$pkgdir/usr/share/applications/mimeinfo.cache"

  _orig_package_processing
}
