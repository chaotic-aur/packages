depends=(${depends[@]//python-pillow*/})
depends=(${depends[@]//python-psutil*/})
depends=(${depends[@]//python-pyqt5*/})
depends=(${depends[@]//python-setuptools*/})
depends=(${depends[@]//python-wheel*/})

makedepends+=('python-wheel')

_pkgsrc="$pkgname"
pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
}
