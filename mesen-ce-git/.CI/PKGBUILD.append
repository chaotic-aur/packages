makedepends=(${makedepends[@]//dotnet-sdk-*/dotnet-sdk})

_pkgsrc="${pkgname%-git}"

eval "_orig_$(declare -f prepare | sed -E -e 's&\b(patch)\b&\1 -F100&')"
prepare() {
  # disable shortcut creation
  sed -E -e '/bool CreateShortcut/s&true&false&' -i "$_pkgsrc"/UI/ViewModels/SetupWizardViewModel.cs

  _orig_prepare
}
