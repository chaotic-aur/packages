export CMAKE_GENERATOR=Ninja
makedepends+=('ninja')

depends=(${depends[@]//gcc-libs*/})

_pkgsrc="$_pkgname"
build() {
  local _cmake_options=(
    -B build
    -S "$_pkgsrc"
    -G Ninja
    -DCMAKE_BUILD_TYPE=None
    -DCMAKE_INSTALL_PREFIX='/usr'
    -Wno-author
  )

  cmake "${_cmake_options[@]}"
  cmake --build build
}

eval "$(declare -f package | sed -E -e '/--prefix/c DESTDIR="$pkgdir" cmake --install "$srcdir/build"')"
