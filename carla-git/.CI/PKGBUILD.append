unset epoch
unset changelog
unset groups

# metadata
url="https://github.com/falkTX/Carla"
license=('GPL-2.0-or-later')

provides=(
  "$_pkgname=${pkgver%.g*}"
  ${provides[@]//${_pkgname}*/}
)

# missing deps
depends+=('sdl2')

# unused deps
depends=(${depends[@]//gcc-libs/})
eval "$(declare -f package | sed -E -e 's&lib(asound|freetype)\.so&&g')"

# fix pkgver
_pkgsrc="$_pkgname"
pkgver() {
  cd "$_pkgsrc"
  local _tag _version _revision _hash
  _tag=$(git tag -l 'v[0-9]*' | grep -Ev '[a-z][a-z]' | sort -rV | head -1)
  _version="${_tag#v}"
  _revision=$(git rev-list --count --cherry-pick "$_tag"...HEAD)
  _hash=$(git rev-parse --short=7 HEAD)
  printf '%s.r%s.g%s' "${_version:?}" "${_revision:?}" "${_hash:?}"
}

# switch to qt6
depends=(${depends[@]//python-pyqt5*/python-pyqt6})
depends=(
  ${depends[@]//qt5-*/}
  'qt6-base'
  'qt6-svg'
)
makedepends=(
  ${makedepends[@]//qt5*/}
  'qt6-tools'
)

eval "$(
  declare -f build \
    | sed -E -e 's&(DEFAULT_QT)=\S+&\1=6&g' \
      -e 's&(HAVE_QT4=false)&\1 HAVE_QT5=false&g'
)"
eval "$(
  declare -f package \
    | sed -E -e 's&(DEFAULT_QT)=\S+&\1=6&g' \
      -e 's&(HAVE_QT4=false)&\1 HAVE_QT5=false&g'
)"
