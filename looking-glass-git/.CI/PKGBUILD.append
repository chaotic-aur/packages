# metadata
unset epoch

url="https://github.com/gnif/LookingGlass"
license=('GPL-2.0-or-later')

# disable march=native
eval "$(declare -f build | sed -E 's&(-DCMAKE_INSTALL_PREFIX=)&-DOPTIMIZE_FOR_NATIVE=OFF \1&')"

# enable libdecor
makedepends+=('libdecor')

eval "$(declare -f build | sed -E 's&(-DCMAKE_INSTALL_PREFIX=)&-DENABLE_LIBDECOR=ON \1&')"

eval "package_looking-glass-git() {
  $(declare -f package_looking-glass-git | tail -n +2)
  depends+=('libdecor')
}"

# disable submodule downloading, prevent prepare failure
_pkgsrc="$_pkgname"
source=("$_pkgsrc"::"git+https://github.com/gnif/LookingGlass.git")
sha512sums=('SKIP')

prepare() {
  cd "$_pkgsrc"
  git submodule update --init --recursive --depth=1
}
