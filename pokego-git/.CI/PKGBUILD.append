url="https://github.com/rubiin/pokego"
pkgdesc="Tool to display Pokémon sprites in the terminal"

provides=('pokego')
conflicts=('pokego')

_pkgsrc="$pkgname"
pkgver() {
  cd "$_pkgsrc"
  git describe --long --tags --abbrev=7 --exclude='*[a-zA-Z][a-zA-Z]*' \
    | sed -E 's/^[^0-9]*//;s/([^-]*-g)/r\1/;s/-/./g'
}
