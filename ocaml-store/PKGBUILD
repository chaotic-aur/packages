pkgname=ocaml-store
pkgver=0.2
pkgrel=1
pkgdesc='Snapshottable data structures for OCaml'
arch=('x86_64')
url='https://gitlab.com/basile.clement/store'
license=('MIT')
depends=('ocaml>=4.14')
makedepends=('dune>=3.7')
source=("$pkgname-$pkgver.tar.bz2::$url/-/archive/v$pkgver/store-v$pkgver.tar.bz2")
sha256sums=('a43b27547309ac95ce428a737428f18bf5f61f957d026e17500e5840dda01d8c')

build() {
  cd "store-v$pkgver"
  dune build -p store --release
}

package() {
  cd "store-v$pkgver"
  DESTDIR="$pkgdir" dune install -p store --prefix /usr --libdir /usr/lib/ocaml --docdir /usr/share/doc --release
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
